{
  "name": "mdust-rs",
  "version": "0.1.1",
  "description": "CommonMark to HTML in WebAssembly, byte-identical to markdown-it 15.0.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younes-io/mdust.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/younes-io/mdust#readme",
  "bugs": {
    "url": "https://github.com/younes-io/mdust/issues"
  },
  "keywords": ["markdown", "commonmark", "markdown-it", "wasm"],
  "main": "./mdust_wasm.js",
  "module": "./mdust_wasm.web.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "import": "./mdust_wasm.mjs",
        "require": "./mdust_wasm.js"
      },
      "browser": "./mdust_wasm.web.mjs",
      "default": "./mdust_wasm.web.mjs"
    },
    "./mdust_wasm_bg.wasm": "./mdust_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "mdust_wasm.js",
    "mdust_wasm.mjs",
    "mdust_wasm.web.mjs",
    "mdust_wasm_bg.wasm",
    "index.d.ts"
  ],
  "scripts": {
    "build": "cd .. && cargo build --profile wasm -p mdust-wasm --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/wasm/mdust_wasm.wasm npm/mdust_wasm_bg.wasm",
    "prepack": "test -f mdust_wasm_bg.wasm || { echo 'mdust_wasm_bg.wasm is missing; run npm run build first' >&2; exit 1; }"
  }
}
